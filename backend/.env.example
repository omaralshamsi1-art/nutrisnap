# --- AI provider: set ONE key. Gemini has a free tier (aistudio.google.com) ---
# LLM_PROVIDER=gemini|anthropic   (auto: Claude if ANTHROPIC_API_KEY is set, else Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Google Search grounding is NOT on Gemini's free tier — set true only on a paid project
GEMINI_GOOGLE_SEARCH=false
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 is a good cost/quality balance; use claude-opus-5-5 for hardest photos
CLAUDE_MODEL=claude-sonnet-5-5
WEB_SEARCH_MAX_USES=6
DEFAULT_COUNTRY=AE
DEFAULT_CITY=Ras Al Khaimah

# --- Server ---
PORT=3000
PUBLIC_BASE_URL=https://api.example.com
# dev: trust X-User-Id (local only) | apikey: X-API-Key only | hybrid: owner API key + invited email accounts | supabase: Supabase JWT
AUTH_MODE=dev
API_KEY=
# hybrid/accounts: signs login sessions (≥32 chars)
AUTH_JWT_SECRET=
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json  (or legacy SUPABASE_JWT_SECRET)
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# Empty = in-memory store (dev). Any Postgres (Railway/Supabase); schema is applied automatically on start.
DATABASE_URL=

# --- WHOOP (developer.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://api.example.com/integrations/whoop/callback
# where the backend sends the user after OAuth (iOS custom URL scheme)
APP_CALLBACK_URL=straineat://whoop
OAUTH_STATE_SECRET=change-me-long-random

# --- Web Push reminders (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://api.example.com
